# ============================================================
# 나라장터 입찰 모니터링 시스템 - 환경변수 설정
# 이 파일을 .env 로 복사한 뒤 값을 채워 넣으세요. (.env는 git에 커밋되지 않습니다)
# ============================================================

# ---- 공공데이터포털(data.go.kr) API 키 -----------------------
# data.go.kr에서 아래 두 API를 각각 "활용신청" 해야 합니다.
#   - 조달청_나라장터 입찰공고정보서비스 (BidPublicInfoService)
#   - 조달청_나라장터 사전규격정보서비스 (HrcspSsstndrdInfoService)
# 승인 후 마이페이지 > 개발계정 상세보기에서 발급되는 키 중
# 반드시 "일반 인증키 (Decoding / 평문)" 값을 사용하세요.
# ("Encoding" 키를 넣으면 URL 인코딩이 이중으로 적용되어
#  SERVICE_KEY_IS_NOT_REGISTERED_ERROR 가 발생할 수 있습니다.)
NARA_BID_SERVICE_KEY=
# 사전규격 API 키가 입찰공고 API 키와 동일하면 비워두세요(자동으로 위 키를 재사용합니다).
NARA_PRESTD_SERVICE_KEY=

# ---- API 엔드포인트 (버전 변경 시에만 수정) --------------------
# data.go.kr이 스키마를 개정하며 서비스 버전을 올리는 경우(BidPublicInfoService04 등)
# 아래 값으로 덮어쓸 수 있습니다. 비워두면 기본값을 사용합니다.
NARA_BID_BASE_URL=
NARA_PRESTD_BASE_URL=

# ---- 조회 옵션 --------------------------------------------------
# 이번 실행에서 조회할 기간(일). 매주 월요일 실행 기준 7일 권장.
LOOKBACK_DAYS=7
# 페이지당 조회 건수 (data.go.kr 권장 최대치 근처)
API_NUM_OF_ROWS=500
# 무한 루프 방지용 최대 페이지 수
API_MAX_PAGES=40
# 요청 타임아웃(ms)
API_TIMEOUT_MS=15000
# 요청 실패 시 재시도 횟수
API_MAX_RETRIES=3
# 재시도 시 기본 대기시간(ms, 지수 백오프의 기준값)
API_RETRY_DELAY_MS=1000
# 연속 요청 사이 최소 간격(ms) - data.go.kr TPS 제한 보호용
API_REQUEST_INTERVAL_MS=300

# ---- 리포트/발송 옵션 -------------------------------------------
# 매칭 결과가 0건이어도 "이번 주 매칭 공고 없음" 리포트를 보낼지 여부
SEND_EMPTY_REPORT=true
# 조회/발송 중 오류가 발생하면 수신자에게 오류 알림 메일을 보낼지 여부
ALERT_EMAIL_ON_FAILURE=true
# true로 설정하면 실제 이메일을 보내지 않고 콘솔 출력 + output/ 폴더에 HTML만 저장합니다.
DRY_RUN=false
# debug | info | warn | error
LOG_LEVEL=info

# ---- SMTP 발신 계정 ----------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# 465 포트 사용 시 true, 587(STARTTLS) 사용 시 false
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# 발신자 표시 이름/주소. 미설정 시 SMTP_USER를 사용합니다.
SMTP_FROM="나라장터 입찰 모니터링 <noreply@example.com>"
